# ── Logs ──
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Build artefacts ──
node_modules
dist
dist-ssr
*.local

# ── Editor / OS ──
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Claude Code config ──
.claude/

# ── Backend (runs on Pi only) ──
backend/__pycache__/
backend/data/*.db
# WAL mode keeps two sidecar files next to the database while the service is
# running. They are not matched by the *.db pattern above and are pure runtime
# state, so they must never be committed.
backend/data/*.db-wal
backend/data/*.db-shm
backend/venv/
*.pyc

# ── Vercel ──
.vercel
.env
.env.local
.env*.local
# Dated hand-made backups of the above, which the patterns miss.
.env.backup-*
